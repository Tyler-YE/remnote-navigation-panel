name: Build RemNote plugin

on:
  push:
    branches: [main, master]
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v6
        with:
          persist-credentials: false
      - uses: actions/setup-node@v7
        with:
          node-version: '22.18.0'
          cache: npm
      - name: Install dependencies
        run: npm ci
      - name: Type check
        run: npm run typecheck
      - name: Test navigation and release configuration
        run: npm test
      - name: Build plugin ZIP
        run: npm run build
        env:
          PLUGIN_REPOSITORY: ${{ github.repository }}
      - name: Verify upload package
        run: npm run verify:package
      - name: Downloadable package
        uses: actions/upload-artifact@v7
        with:
          name: RemNote-plugin-package
          path: release/*
          if-no-files-found: error
          retention-days: 30
